  "firestore": {
    "/authorizedUsers/{userId}": {
      "entity": "AuthorizedUser",
      "description": "Administrator allowlist store determining whether an authenticated Firebase user has explicit application access"
    },
    "/shipments/{shipmentId}": {
      "entity": "Shipment",
      "description": "Live freight shipments and tracking records accessible by public tracking and managed by staff"
    },
    "/quotes/{quoteId}": {
      "entity": "Quote",
      "description": "Customer freight rate requests and quotes"
    },
    "/messages/{messageId}": {
      "entity": "ContactMessage",
      "description": "Customer inquiries and dispatch messages"
    },
    "/subscribers/{subscriberId}": {
      "entity": "Subscriber",
      "description": "Newsletter and global trade intelligence email subscribers"
    },
    "/users/{userId}": {
      "entity": "User",
      "description": "Authenticated logistics operators and admin profiles"
    },
    "/company_info/{docId}": {
      "entity": "CompanyInfo",
      "description": "Centralized company profile containing phone numbers, emails, addresses, licenses, and global operations configuration"
