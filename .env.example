# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# REAL EMAIL DISPATCH PROVIDER CREDENTIALS (SERVER-SIDE ONLY):
# ==============================================================================
# NO CUSTOM DOMAIN NEEDED:
# You do NOT need a domain yet! You can send and receive real emails using
# your standard personal Gmail account (gillesawo6@gmail.com) with a free
# 16-character Google App Password.
#
# QUICK 4-STEP GMAIL APP PASSWORD SETUP:
# 1. Open your Google Account (myaccount.google.com) > Security.
# 2. Make sure "2-Step Verification" is ON.
# 3. Go to myaccount.google.com/apppasswords (or search "App passwords").
# 4. Enter app name "Nexora Logistics" and click "Create".
# 5. Copy the 16-character password and paste it into SMTP_PASS below!
#
# SENDER & SMTP CONFIGURATION:
# Outgoing emails will be sent securely via Gmail SMTP (displaying as
# "NEXORA Global Logistics <gillesawo6@gmail.com>").
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="gillesawo6@gmail.com"
SMTP_PASS=""
SMTP_FROM="gillesawo6@gmail.com"
# Note: GMAIL_APP_PASSWORD, GMAIL_PASS, EMAIL_USER, EMAIL_PASS aliases are also automatically detected.

# ALTERNATIVE: GOOGLE OAUTH2 (Optional):
GOOGLE_SENDER_EMAIL="gillesawo6@gmail.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_REDIRECT_URI="https://developers.google.com/oauthplayground"
# Note: GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN aliases are also automatically detected.

# COMPANY & ADMIN INTERNAL NOTIFICATIONS RECIPIENT:
# Where internal desk alerts (new customer quote requests, contact form messages, etc.)
# are delivered. Since you don't have a domain yet, this sends alerts straight to your Gmail:
COMPANY_EMAIL="gillesawo6@gmail.com"
ADMIN_NOTIFICATION_EMAIL="gillesawo6@gmail.com"

